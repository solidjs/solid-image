{
  "name": "@solidjs/image",
  "version": "0.1.0",
  "description": "Optimized image components and Vite tooling for Solid.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solidjs/solid-image.git"
  },
  "bugs": {
    "url": "https://github.com/solidjs/solid-image/issues"
  },
  "homepage": "https://github.com/solidjs/solid-image#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "env.d.ts"
  ],
  "scripts": {
    "build": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "test:node": "vitest run --project node",
    "test:browser": "vitest run --project browser",
    "test:watch": "vitest",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  },
  "peerDependencies": {
    "solid-js": "^1.9.9",
    "vite": "^8 || ^9"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@tsdown/css": "^0.22.12",
    "@types/node": "^25.5.0",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "playwright": "^1.63.0",
    "solid-js": "^1.9.9",
    "tsdown": "^0.22.12",
    "typescript": "^7.0.0",
    "vite": "^8.1.5",
    "vite-plugin-solid": "^2.11.11",
    "vitest": "^4.0.10"
  },
  "exports": {
    ".": "./dist/index.jsx",
    "./env": "./env.d.ts",
    "./vite": "./dist/vite.js",
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.13.0"
}
